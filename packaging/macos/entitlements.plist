<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only used with the hardened runtime (notarized builds), which Python needs loosened. -->
<plist version="1.0">
<dict>
    <!-- ctypes and pyobjc create callbacks (libffi closures) in writable memory -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- the standalone Python and the wheels' extension modules weren't signed by our team -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- per-app volume asks apps such as Music over Apple events -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
